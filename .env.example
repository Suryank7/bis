# Living Documentation Copilot - Environment Configuration

# =====================================
# DOCUMENT SOURCE CONFIGURATION
# =====================================
# Path to the folder containing your documentation files
DOCS_PATH=./data/docs

# =====================================
# SERVER CONFIGURATION
# =====================================
HOST=0.0.0.0
PORT=8000

# =====================================
# LLM CONFIGURATION (Choose One)
# =====================================

# Option 1: Ollama (FREE - Recommended)
# Install Ollama from https://ollama.ai and run: ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: OpenAI (Requires API Key)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# =====================================
# EMBEDDING CONFIGURATION
# =====================================
# Using sentence-transformers locally (FREE - No API Key)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =====================================
# RAG CONFIGURATION
# =====================================
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# =====================================
# LOGGING
# =====================================
LOG_LEVEL=INFO
